import random
import art

def deal_card():
    """ it gives us a random card from the deck"""
    cards = [11, 2, 3, 4, 5, 6, 7, 8, 9, 10, 10, 10, 10]
    card = random.choice(cards)
    return card


def calculate_score(cards):
    """ it gives us a score from the deck and add cards to list if needed"""
    if sum(cards) == 21 and len(cards) == 2:
        return 0  # means Blackjack
    elif 11 in cards and sum(cards) > 21:
        cards.remove(11)
        cards.append(1)
        return sum(cards)
    else:
        return sum(cards)


def compare(user_score,opponent_score ):
    """It compares the user and opponent score and give use result according to that"""
    if user_score == opponent_score:
        return "draw 😎"
    elif user_score == 0:
        return "user wins 😎 with blackjack"
    elif  opponent_score == 0:
        return "opponent wins 😭 with blackjack"
    elif user_score > 21:
        return "user busts, opponent wins 😭"
    elif opponent_score > 21:
        return "opponent busts, user wins 😎"
    elif user_score > opponent_score:
        return "user wins 😎"
    else:
        return "opponent wins 😭"

def play_game():
    """Main game function"""
    print(art.logo)
    user_cards = []
    opponent_cards = []
    user_score = -1
    opponent_score = -1

    for _ in range(2):
        user_cards.append(deal_card())
        opponent_cards.append(deal_card())
    is_game_over = False

    while not is_game_over:
        user_score = calculate_score(user_cards)
        opponent_score = calculate_score(opponent_cards)
        print(f"user cards: {user_cards} user score: {user_score}\nopponent cards: {opponent_cards[0]}")
        if user_score == 0 or opponent_score == 0 or user_score > 21:
            is_game_over = True
        else:
            adding_card = input("Type 'y' to hit to add new cards, 'n' to stand to print game result")
            if adding_card == "y":
                user_cards.append(deal_card())
            else:
                is_game_over = True


    while opponent_score != 0 and opponent_score < 17:
        opponent_cards.append(deal_card())
        opponent_score = calculate_score(opponent_cards)
    print(compare(user_score, opponent_score))
    print(f"opponent final hand: {opponent_cards} opponent final  score: {opponent_score}\nuser final hand: {user_cards} user final score: {user_score}")


if input("Play Blackjack? (y/n): ").lower() == "y":
    play_game()

while input("Do you want to play again? (y/n): ").lower() == "y":
    print("\n" * 50)
    play_game()

