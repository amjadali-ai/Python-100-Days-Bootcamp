# take two random accounts from data
def select():
	""" it will give random account"""
	return random.choice(data)

# Generate a random account from data
def format_account(account):
	"""Formats the account for printing"""
	name = account["name"]
	followers = account["follower_count"]
	desc = account["description"]
	country = account["country"]
	return f"{name}, {followers}, a {desc}, from {country}"


# compare followers of both make function for it
def compare(account1, account2,account3,guess):
	""" Compare three accounts """
	if account1["follower_count"] > account2["follower_count"] and account1["follower_count"] > account3["follower_count"]:
		return guess == "a"
	elif account2["follower_count"] > account1["follower_count"] and account2["follower_count"] > account3["follower_count"]:
		return guess == "b"
	else:
		return guess == "c"

# check correctness
