	""" Play a game of Higher or Lower """
	score = 0
	account_a = select()
	should_continue = True
	while should_continue:
		account_b = select()
		while account_b == account_a:
			account_b = select()
		account_c = select()
		while account_c == account_a or account_c == account_b:
			account_c = select()

			# Now all 3 are different
			# ... display, guess, compare ...
		print(f"Compare A: {format_account(account_a)}")
		print(art.vs)
		print(f"against B: {format_account(account_b)}")
